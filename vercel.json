{
  "rewrites": [
    {
      "source": "/((?!formatura-carol\\.ics).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/formatura-carol.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=formatura-carol.ics"
        }
      ]
    }
  ]
}